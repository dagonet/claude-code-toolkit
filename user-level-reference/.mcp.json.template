{
  "_note_git_tools": "git-tools is OPTIONAL since v2.0: the toolkit uses the native git CLI and gates it with hooks. Nothing breaks if you drop this entry. Note that git work done through these MCP tools bypasses the pre-commit / no-push-main / merge gates, which key on Bash and PowerShell commands.",
  "mcpServers": {
    "git-tools": {
      "command": "{{PYTHON_VENV_PATH}}/mcp-git-tools.exe"
    },
    "github-tools": {
      "command": "{{PYTHON_VENV_PATH}}/mcp-github-tools.exe",
      "env": {
        "GH_PROMPT_DISABLED": "1"
      }
    },
    "MCP_DOCKER": {
      "command": "docker",
      "args": ["mcp", "gateway", "run"]
    },
    "template-sync-tools": {
      "command": "{{PYTHON_VENV_PATH}}/mcp-template-sync-tools.exe"
    },
    "python-tools": {
      "command": "{{PYTHON_VENV_PATH}}/mcp-python-tools.exe"
    },
    "ollama-tools": {
      "command": "{{PYTHON_VENV_PATH}}/mcp-ollama-tools.exe",
      "env": {
        "OLLAMA_URL": "http://127.0.0.1:11434",
        "OLLAMA_MODEL_FIRST_PASS": "{{OLLAMA_MODEL_FIRST_PASS}}",
        "OLLAMA_MODEL_EXTRACT_JSON": "{{OLLAMA_MODEL_EXTRACT_JSON}}"
      }
    },
    "open-brain": {
      "command": "{{OPEN_BRAIN_COMMAND}}",
      "args": ["{{OPEN_BRAIN_ARGS}}"]
    },
    "searxng": {
      "command": "{{SEARXNG_COMMAND}}",
      "args": ["{{SEARXNG_ARGS}}"],
      "env": {
        "SEARXNG_URL": "{{SEARXNG_INSTANCE_URL}}"
      }
    }
  }
}
