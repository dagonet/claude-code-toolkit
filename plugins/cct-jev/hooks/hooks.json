{
  "hooks": {
    "SessionStart": [
      { "hooks": [
        { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/cct-jev-session.sh\"" },
        { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.sh\" jev-notice", "timeout": 5 }
      ] }
    ],
    "SessionEnd": [
      { "hooks": [
        { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/cct-jev-session.sh\" end", "timeout": 5 }
      ] }
    ],
    "PreToolUse": [
      { "matcher": "Agent", "hooks": [
        { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.sh\" jev-route", "timeout": 5 }
      ] }
    ]
  }
}
