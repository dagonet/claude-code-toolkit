{
  "mcpServers": {
    "ollama-tools": {
      "command": "uvx",
      "args": ["--from", "mcp-dev-servers @ git+https://github.com/dagonet/mcp-dev-servers@0a20b97dd42733c629e369e16f4e79af81f93d47", "mcp-ollama-tools"],
      "env": {
        "OLLAMA_URL": "${user_config.ollama_url}",
        "OLLAMA_MODEL_FIRST_PASS": "${user_config.model_first_pass}",
        "OLLAMA_MODEL_EXTRACT_JSON": "${user_config.model_extract_json}"
      }
    }
  }
}
